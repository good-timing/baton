# Baton SDK — vendor-side environment variables
#
# Copy this to .env (gitignored) and fill in real values for local development.
# Production deployments should source these from the vendor's secrets management.

# REQUIRED: Console ingest endpoint (where the SDK posts events).
# For local development, point at a locally-running baton-console instance.
BATON_CONSOLE_URL=http://localhost:8000

# REQUIRED: API key for the Console ingest endpoint.
# In Phase 1 single-tenant deployments, this is generated by the Console at tenant provisioning.
BATON_API_KEY=replace-with-real-key

# OPTIONAL: vendor identifier (defaults to value in VendorConfig).
# BATON_VENDOR_ID=your-vendor

# OPTIONAL: enable verbose SDK logging for debugging.
# BATON_DEBUG=1
