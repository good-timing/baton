# Python
.venv
__pycache__
*.pyc
*.pyo
*.egg-info
build/
dist/

# The documented install path (Makefile's `install` target, CLAUDE.md) is
# pip inside a venv, not uv — nothing in the Makefile or CI reads/enforces
# uv.lock (no `uv lock --check` anywhere), so a locally-generated one would
# be an unmaintained, silently-stale duplicate of pyproject.toml's
# dependency resolution if committed. Keep it local-only.
uv.lock

# Test + coverage caches
.pytest_cache
.mypy_cache
.ruff_cache
.coverage
coverage.json
coverage.xml
coverage/
htmlcov/

# Environment
.env
.envrc
*.local.*

# Claude Code session state
.claude/
.cursor/

# OS
.DS_Store
Thumbs.db

# IDE
.vscode/
.idea/
*.swp
*.swo

# Logs
logs/
*.log

# Local notes (preserve docs/ but ignore scratch)
scratch/
events.jsonl

# Demo/corpus output that might be generated locally for ad-hoc testing.
baton-events.jsonl

# Local DBs / lockfiles that some spike or future Console-test infra might drop
*.pid
*.sqlite
*.sqlite-journal
*.db
.git.old/

# Local workflow state (per-effort state files; not source-controlled)
STATE.md
INDEX.md
.state-link
